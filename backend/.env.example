# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Data ------------------------------------------------------------------
# memory = zero-setup demo store with seeded Togo data (dev/test only)
# mongo  = MongoDB (required in production)
DATA_DRIVER=memory
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/discover_togo?retryWrites=true&w=majority

# --- Auth ------------------------------------------------------------------
# dev      = accepts "Bearer dev:<uid>:<user|editor|admin>" (refused when NODE_ENV=production)
# firebase = verifies Firebase ID tokens (production)
AUTH_MODE=dev
# FIREBASE_PROJECT_ID=discover-togo
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# Verified emails that become admin on first sign-in
ADMIN_EMAILS=

# --- HTTP security ---------------------------------------------------------
# Browser origins allowed by CORS (admin dashboard, Expo web). Native apps send no Origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
# Number of trusted reverse-proxy hops (Cloud Run / load balancer = 1)
TRUST_PROXY=0
# Defaults to true in production
# REQUIRE_HTTPS=true
RATE_LIMIT_ENABLED=true
IMAGE_HOSTS=firebasestorage.googleapis.com,storage.googleapis.com,images.unsplash.com,upload.wikimedia.org
