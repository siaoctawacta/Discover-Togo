# Discover Togo admin dashboard — copy to `.env.local` (git-ignored) and fill in.

# REST API base URL (must include /api/v1). Its origin is added to the CSP connect-src at build time.
VITE_API_URL=http://localhost:4000/api/v1

# Firebase web app config (Firebase console > Project settings > Your apps). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Local development only: `1` shows a dev login that sends `Bearer dev:<uid>:<role>`.
# Requires the API to run with AUTH_MODE=dev. Ignored in `production` mode builds.
VITE_DEV_AUTH=0
