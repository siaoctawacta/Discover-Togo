# Discover Togo mobile — copy to `.env` and fill in. All EXPO_PUBLIC_* values are
# embedded in the JS bundle: they are NOT secrets. Restrict keys in Google Cloud / Firebase.

# REST API base URL. Must be https:// in production builds (http is refused outside __DEV__).
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Firebase (Auth only). Leave empty to run without auth ("not configured" on auth screens).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google sign-in OAuth client ids (Google Cloud console → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google Maps SDK key (restrict to bundle id app.discovertogo.mobile + Android SHA-1)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dev only: show a "Dev login" button that uses the backend AUTH_MODE=dev token format
# (Bearer dev:<uid>:user). Ignored in production builds (__DEV__ === false).
EXPO_PUBLIC_DEV_AUTH=0

# Monetization: render AdSlot placeholders
EXPO_PUBLIC_ADS_ENABLED=0
